# Copy to .env and adjust. Nothing here is read from the filesystem at runtime:
# the server reads the process environment.

# THE ENTIRE DATASET. One committed JSON file, no database and no migrations.
# This file MUST be committed to git — .gitignore deliberately does not ignore
# data/ or anything under it. Only re-run `make ingest` to regenerate it.
DATA_FILE=data/lamine.json

# HTTP listen port.
PORT=8080

# REQUIRED for every POST/PATCH/PUT/DELETE. Requests without a matching
# X-Admin-Token header get 401. Change this before exposing the API.
ADMIN_TOKEN=dev-admin-token

# Comma-separated allowlist for browser CORS. The Next.js dev server is :3000.
CORS_ORIGIN=http://localhost:3000

# One structured log line per request.
LOG_REQUESTS=true
