# Notion integration token: create one at https://www.notion.so/profile/integrations,
# then open the goals database in Notion → ••• → Connections → add your integration.
# Server only: never rename it to NEXT_PUBLIC_*, or it would ship to the browser.
NOTION_TOKEN=

# The goals database (an id or the full link both work).
# https://app.notion.com/p/bourbonzero/404f312eab25808095c8c45766b08e4d
NOTION_GOALS_DATABASE_ID=404f312eab25808095c8c45766b08e4d

# The highlights database: create an empty one, connect the integration to it like
# the goals one, paste its id here, then `npm run notion:sync -- highlights` adds the
# columns and the videos from data/lamine_yamal_highlights.json.
NOTION_HIGHLIGHTS_DATABASE_ID=

# Public origin used for canonical URLs, Open Graph URLs, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
